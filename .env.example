# Copy to .env and fill in. NEVER commit .env or any key file.
# Account identifier from your Snowsight URL: app.snowflake.com/<region>/<locator>/...
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=DM_WH
SNOWFLAKE_READER_ROLE=DM_READER
SNOWFLAKE_LOADER_ROLE=DM_LOADER

# Authentication. Preferred: key pair (run.bat keygen creates the key, fills this path, and prints the SQL to register it).
SNOWFLAKE_PRIVATE_KEY_PATH=
# Otherwise EITHER a programmatic access token OR a password (priority: key, then token, then password).
SNOWFLAKE_PAT=
SNOWFLAKE_PASSWORD=

# Seconds before Snowflake cancels any single statement (protects trial credits).
DM_STATEMENT_TIMEOUT=60

# Gemma via Ollama cloud (key from https://ollama.com/settings/keys):
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
GEMMA_MODEL=gemma4:31b
# Alternative A (no API key in .env): install Ollama, run `ollama signin`, leave OLLAMA_HOST and OLLAMA_API_KEY empty, set GEMMA_MODEL=gemma4:cloud
# Alternative B (fully local): leave OLLAMA_HOST and OLLAMA_API_KEY empty, run `ollama pull gemma3n:e4b`, set GEMMA_MODEL=gemma3n:e4b
